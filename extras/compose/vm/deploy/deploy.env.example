# /etc/portal/deploy.env (root:root, 0644), wird von portal-deploy eingelesen
PORTAL_IMAGE=hka/portal:0.3.0-gateway   # = PORTAL_IMAGE_TAG in awp-hka-security-gateway/vm/.env
MANIFESTS_DIR=/srv/portal/manifests
REGISTRY_DIR=/srv/portal/registry
STATUS_DIR=/srv/portal/status          # nur für list; ohne den Wert zeigt list den Status als unbekannt
# PORTAL_CONFIG_IN_IMAGE=/opt/app/dev/gateway.vm.yml
# PORTAL_LANG=en                       # Sprache der Ausgabe: de oder en (Standard: nach LC_ALL, LC_MESSAGES, LANG, sonst de)

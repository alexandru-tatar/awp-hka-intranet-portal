# /etc/portal/deploy.env (root:root, 0644), wird von portal-deploy eingelesen
PORTAL_IMAGE=hka/portal:0.2.1-gateway
MANIFESTS_DIR=/srv/portal/manifests
REGISTRY_DIR=/srv/portal/registry
STATUS_DIR=/srv/portal/status          # nur für list; ohne den Wert zeigt list den Status als unbekannt

#!/bin/bash
# Manuelle Registrierung und Verwaltung von Apps auf der Test-VM (HKA-53, HKA-56).
#
# Aufruf als sadmin, nachdem das Manifest per scp auf die VM kopiert wurde (README.md in diesem Ordner):
#   sudo portal-deploy check    --owner <owner/repo> < ~/manifests/<slug>.json   # prüft nur, schreibt nichts
#   sudo portal-deploy register --owner <owner/repo> < ~/manifests/<slug>.json   # legt das Manifest im Portal ab
#   sudo portal-deploy list                                                       # alle Apps mit Besitzer und Status
#   sudo portal-deploy remove <slug> --owner <owner/repo>                         # legt die App still
#
# Das Skript startet das Portal-Image mit festen Argumenten: ohne Netz, schreibgeschützt, ohne Capabilities. Prüfung und
# Ablage macht "python -m portal.registry" im Container (PF-104, PF-202, PF-204).
#
# Installation: sudo install -m 0755 -o root -g root portal-deploy /usr/local/sbin/portal-deploy
# Einstellungen: /etc/portal/deploy.env (README.md in diesem Ordner)
#
# Sprache der Ausgabe, Deutsch oder Englisch (HKA-101): PORTAL_LANG=de|en (Umgebung oder deploy.env), sonst LC_ALL,
# LC_MESSAGES, LANG ("en…" = Englisch), sonst Deutsch. Der Wert geht mit "-e PORTAL_LANG=…" in den Container.
set -euo pipefail

if [ "$(id -u)" -eq 0 ]; then
  PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
  ENV_FILE=/etc/portal/deploy.env
else
  # Nur für Tests ohne root: Ersatz-docker im PATH und eigene Einstellungen.
  ENV_FILE=${PORTAL_DEPLOY_ENV:-/etc/portal/deploy.env}
fi

# Sprache: de oder en. PORTAL_LANG aus der Umgebung, sonst aus deploy.env (nur gelesen, nicht ausgeführt), sonst LC_*.
pick_lang() {
  local value=${PORTAL_LANG:-}
  if [ -z "$value" ] && [ -r "$ENV_FILE" ]; then
    value=$(sed -n 's/^PORTAL_LANG=\([A-Za-z]*\).*/\1/p' "$ENV_FILE" | head -n 1)
  fi
  case "$value" in
    en|EN) echo en; return ;;
    de|DE) echo de; return ;;
  esac
  for value in "${LC_ALL:-}" "${LC_MESSAGES:-}" "${LANG:-}"; do
    if [ -n "$value" ]; then
      case "$value" in en|en_*|en.*) echo en ;; *) echo de ;; esac
      return
    fi
  done
  echo de
}
LANG_CODE=$(pick_lang)

if [ "$LANG_CODE" = en ]; then
  usage="Usage: sudo portal-deploy check|register --owner <owner/repo> < manifest.json
       sudo portal-deploy list
       sudo portal-deploy remove <slug> --owner <owner/repo>"
  M_REFUSED="refused"; M_ARGS="wrong number of arguments"; M_NO_OWNER="call without --owner"
  M_BAD_SLUG="invalid app name"; M_ONLY="only check, register, list or remove allowed"; M_BAD_OWNER="invalid owner"
  M_NO_STDIN="manifest missing on standard input"; M_MISSING="is missing in"
else
  usage="Aufruf: sudo portal-deploy check|register --owner <owner/repo> < manifest.json
        sudo portal-deploy list
        sudo portal-deploy remove <slug> --owner <owner/repo>"
  M_REFUSED="abgelehnt"; M_ARGS="falsche Anzahl Argumente"; M_NO_OWNER="Aufruf ohne --owner"
  M_BAD_SLUG="ungültiger Name der App"; M_ONLY="nur check, register, list oder remove erlaubt"; M_BAD_OWNER="ungültiger Besitzer"
  M_NO_STDIN="Manifest fehlt auf der Standardeingabe"; M_MISSING="fehlt in"
fi
log() { command -v logger >/dev/null 2>&1 && logger -t portal-deploy -- "$*" || true; }
refuse() { log "$M_REFUSED: $1 (owner=${OWNER:-?})"; echo "portal-deploy: $1" >&2; echo "$usage" >&2; exit 2; }

OWNER=
SLUG=
COMMAND=${1-}
case "$COMMAND" in
  check|register)
    if [ "$#" -ne 3 ]; then refuse "$M_ARGS"; fi
    if [ "$2" != "--owner" ]; then refuse "$M_NO_OWNER"; fi
    OWNER=$3 ;;
  list)
    if [ "$#" -ne 1 ]; then refuse "$M_ARGS"; fi ;;
  remove)
    if [ "$#" -ne 4 ]; then refuse "$M_ARGS"; fi
    SLUG=$2
    if [ "$3" != "--owner" ]; then refuse "$M_NO_OWNER"; fi
    OWNER=$4
    if ! [[ "$SLUG" =~ ^[a-z][a-z0-9-]{2,30}$ ]]; then refuse "$M_BAD_SLUG"; fi ;;
  *)
    if [ "$#" -lt 1 ] || [ "$#" -gt 4 ]; then refuse "$M_ARGS"; fi
    refuse "$M_ONLY" ;;
esac
if [ "$COMMAND" != list ]; then
  if ! [[ "$OWNER" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*/[A-Za-z0-9._-]+$ ]]; then refuse "$M_BAD_OWNER"; fi
fi
case "$COMMAND" in
  check|register) if [ -t 0 ]; then refuse "$M_NO_STDIN"; fi ;;
esac
case "$COMMAND" in
  register|remove) WRITABLE=rw ;;
  *) WRITABLE=ro ;;
esac

# shellcheck source=/dev/null
. "$ENV_FILE"
: "${PORTAL_IMAGE:?PORTAL_IMAGE $M_MISSING $ENV_FILE}"
: "${MANIFESTS_DIR:?MANIFESTS_DIR $M_MISSING $ENV_FILE}"
: "${REGISTRY_DIR:?REGISTRY_DIR $M_MISSING $ENV_FILE}"
PORTAL_CONFIG_IN_IMAGE=${PORTAL_CONFIG_IN_IMAGE:-/opt/app/dev/gateway.vm.yml}

# Statusdatei des Portals (HKA-56): nur lesen, nur für list. Ohne STATUS_DIR zeigt list den Status als unbekannt.
STATUS_MOUNT=()
if [ "$COMMAND" = list ] && [ -n "${STATUS_DIR:-}" ]; then
  STATUS_MOUNT=(-v "$STATUS_DIR:/var/lib/portal/status:ro")
fi
ARGS=("$COMMAND")
if [ -n "$SLUG" ]; then ARGS+=("$SLUG"); fi
ARGS+=(--config "$PORTAL_CONFIG_IN_IMAGE")
if [ -n "$OWNER" ]; then ARGS+=(--owner "$OWNER"); fi

log "$COMMAND ${SLUG:+slug=$SLUG }owner=${OWNER:--} user=${SUDO_USER:-$(id -un)}"
exec docker run --rm -i \
  --network none --read-only --tmpfs /tmp \
  --cap-drop ALL --security-opt no-new-privileges \
  -e "PORTAL_LANG=$LANG_CODE" \
  --memory 256m --pids-limit 64 \
  -v "$MANIFESTS_DIR:/var/lib/portal/manifests:$WRITABLE" \
  -v "$REGISTRY_DIR:/var/lib/portal/registry:$WRITABLE" \
  ${STATUS_MOUNT[@]+"${STATUS_MOUNT[@]}"} \
  --entrypoint python \
  "$PORTAL_IMAGE" \
  -m portal.registry "${ARGS[@]}"

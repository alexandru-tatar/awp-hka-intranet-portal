# Verwaltete Datei: in allen Startern gleich, nur RUNNER unterscheidet sich.
# Die fünf Befehle: dev, start, test, lint, docker
RUNNER := npm run
.PHONY: dev start test lint docker
dev:    ; $(RUNNER) dev
start:  ; $(RUNNER) start
test:   ; $(RUNNER) test
lint:   ; $(RUNNER) lint
docker: ; $(RUNNER) docker

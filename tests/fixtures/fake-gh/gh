#!/usr/bin/env python3
"""Attrappe für die GitHub-CLI (gh), nur für tests/test_neue_app.py.

Antwortet aus einer JSON-Datei ($FAKE_GH_STATE) und schreibt jeden Aufruf als JSON-Zeile in
$FAKE_GH_LOG: Argumente, Methode, Endpunkt und den SHA-256 der Standardeingabe. Der Inhalt der
Standardeingabe steht nur im Log, wenn es kein Geheimnis ist (``gh api --input``).
Anlegen und Ändern verändern den Zustand, damit spätere Aufrufe es sehen.
"""

import base64
import hashlib
import json
import os
import subprocess
import sys

STATE_PATH = os.environ["FAKE_GH_STATE"]
LOG_PATH = os.environ["FAKE_GH_LOG"]
MIT_WERT = {"-H", "-X", "-f", "-F", "--jq", "-q", "--input", "--env", "--repo", "--template", "--description", "--add-topic", "-R"}


def lade():
    with open(STATE_PATH, encoding="utf-8") as f:
        return json.load(f)


def speichere(state):
    with open(STATE_PATH, "w", encoding="utf-8") as f:
        json.dump(state, f)


def protokolliere(eintrag):
    with open(LOG_PATH, "a", encoding="utf-8") as f:
        f.write(json.dumps(eintrag) + "\n")


def antwort(daten, jq=None):
    text = daten if isinstance(daten, str) else json.dumps(daten)
    if jq:
        text = subprocess.run(["jq", "-r", jq], input=text, capture_output=True, text=True, check=True).stdout
        sys.stdout.write(text)
    else:
        sys.stdout.write(text if text.endswith("\n") else text + "\n")
    sys.exit(0)


def nicht_gefunden():
    sys.stderr.write("gh: Not Found (HTTP 404)\n")
    sys.exit(1)


def zerlege(argv):
    positionen, optionen = [], {}
    i = 0
    while i < len(argv):
        a = argv[i]
        if a in MIT_WERT:
            optionen.setdefault(a, []).append(argv[i + 1])
            i += 2
        elif a.startswith("-"):
            optionen.setdefault(a, []).append(True)
            i += 1
        else:
            positionen.append(a)
            i += 1
    return positionen, optionen


def main():
    argv = sys.argv[1:]
    state = lade()
    positionen, opt = zerlege(argv)
    eintrag = {"argv": argv}

    liest_stdin = ("--input" in opt and "-" in opt["--input"]) or positionen[:2] == ["secret", "set"]
    if liest_stdin:
        daten = sys.stdin.buffer.read()
        eintrag["stdin_sha256"] = hashlib.sha256(daten).hexdigest()
        if "--input" in opt:
            eintrag["stdin"] = daten.decode("utf-8")
    jq = (opt.get("--jq") or opt.get("-q") or [None])[0]

    kommando = positionen[0] if positionen else ""

    if kommando == "auth":
        protokolliere(eintrag)
        sys.exit(0)

    if kommando == "secret":
        eintrag["aktion"] = "secret"
        eintrag["name"] = positionen[2]
        eintrag["env"] = opt.get("--env", [None])[0]
        protokolliere(eintrag)
        state.setdefault("secrets", []).append({"name": positionen[2], "env": eintrag["env"], "sha256": eintrag["stdin_sha256"]})
        speichere(state)
        sys.exit(0)

    if kommando == "repo":
        unter = positionen[1]
        repo = positionen[2]
        eintrag["aktion"] = "repo " + unter
        eintrag["repo"] = repo
        protokolliere(eintrag)
        if unter == "create":
            vorlage = opt["--template"][0].split("/", 1)[1]
            state["repos"][repo.split("/", 1)[1]] = {
                "manifest": state["vorlagen"][vorlage]["manifest"],
                "sha": "sha-manifest-0",
                "branches": ["main"],
                "angelegt_nach_abfragen": state.get("verzoegerung", 0),
            }
            speichere(state)
        sys.exit(0)

    if kommando != "api":
        sys.stderr.write("fake-gh: unbekannter Aufruf %r\n" % (argv,))
        sys.exit(2)

    endpunkt = positionen[1]
    methode = (opt.get("-X") or ["GET"])[0]
    felder = {}
    for eintrag_f in opt.get("-f", []) + opt.get("-F", []):
        k, _, v = eintrag_f.partition("=")
        felder[k] = v
    roh = any("raw" in h for h in opt.get("-H", []))
    eintrag.update({"aktion": "api", "methode": methode, "endpunkt": endpunkt})
    protokolliere(eintrag)

    teile = endpunkt.split("/")
    if endpunkt == "user":
        antwort({"login": state["login"]}, jq)
    if endpunkt == "search/repositories":
        antwort({"items": [{"name": n} for n in state["apps"]]}, jq)

    if teile[0] != "repos":
        nicht_gefunden()
    name = teile[2]
    rest = "/".join(teile[3:])

    if name == state["portal"]:
        if rest == "contents/dev/manifests":
            antwort([{"name": n, "path": "dev/manifests/" + n} for n in state["manifeste"]], jq)
        if rest.startswith("contents/dev/manifests/"):
            n = rest.rsplit("/", 1)[1]
            if n not in state["manifeste"]:
                nicht_gefunden()
            antwort(state["manifeste"][n], jq)
        if rest == "collaborators":
            antwort([{"login": m} for m in state["mitglieder"]], jq)
        if rest == "":
            antwort({"name": name}, jq)
        nicht_gefunden()

    if name in state["vorlagen"]:
        vorlage = state["vorlagen"][name]
        if rest == "":
            antwort({"name": name, "is_template": vorlage["is_template"]}, jq)
        if rest == "contents/.github/workflows/pruefung.yml":
            if vorlage["workflow"]:
                antwort({"name": "pruefung.yml"}, jq)
            nicht_gefunden()
        nicht_gefunden()

    # App-Repositories: bereits vorhandene (state["apps"]) und neu angelegte (state["repos"])
    if name in state["apps"]:
        if rest == "contents/manifest.json":
            antwort(state["apps"][name], jq)
        if rest == "":
            antwort({"name": name}, jq)
        nicht_gefunden()

    if name not in state["repos"]:
        nicht_gefunden()
    app = state["repos"][name]
    if state.get("fehler_bei") == rest:
        sys.stderr.write("gh: Server Error (HTTP 500)\n")
        sys.exit(1)
    if rest == "":
        antwort({"name": name}, jq)
    if rest == "contents/manifest.json":
        if app["angelegt_nach_abfragen"] > 0:
            app["angelegt_nach_abfragen"] -= 1
            speichere(state)
            nicht_gefunden()
        if methode == "PUT":
            app["manifest"] = base64.b64decode(felder["content"]).decode("utf-8")
            app["sha"] = "sha-manifest-1"
            speichere(state)
            antwort({"commit": {"sha": "sha-commit-1"}}, jq)
        if roh:
            antwort(app["manifest"], jq)
        inhalt = base64.b64encode(app["manifest"].encode("utf-8")).decode("ascii")
        antwort({"sha": app["sha"], "content": inhalt}, jq)
    if rest == "git/ref/heads/main":
        antwort({"object": {"sha": "sha-main-" + app["sha"]}}, jq)
    if rest == "git/refs" and methode == "POST":
        app["branches"].append(felder["ref"].rsplit("/", 1)[1])
        speichere(state)
        antwort({"ref": felder["ref"]}, jq)
    if rest.startswith("collaborators/") and methode == "PUT":
        antwort({}, jq)
    if rest.startswith("environments/") and methode == "PUT":
        antwort({"name": rest.split("/", 1)[1]}, jq)
    if rest == "rulesets" and methode == "POST":
        antwort({"id": 1}, jq)
    nicht_gefunden()


main()
